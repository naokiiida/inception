# OpenSSL Server Certificate Configuration
# This file is used to generate server certificate signing requests (CSR)
# Simplified for 42 Inception project - only requires LOGIN.42.fr domain

[ req ]
default_bits        = 2048
distinguished_name  = req_distinguished_name
string_mask         = utf8only
default_md          = sha256
# Extension to add when generating the CSR
req_extensions      = v3_req
prompt              = no

[ req_distinguished_name ]
# When prompt = no, these are used as the actual values (not prompts)
C                               = JP
ST                              = Tokyo
L                               = Tokyo
O                               = 42 Tokyo
OU                              = Cadet
CN                              = LOGIN.42.fr

[ v3_req ]
# Extensions to add to a certificate request
basicConstraints = CA:FALSE
keyUsage = nonRepudiation, digitalSignature, keyEncipherment
subjectAltName = @alt_names

[ alt_names ]
# Domain will be replaced by script - only LOGIN.42.fr and localhost
DNS.1 = LOGIN.42.fr
DNS.2 = localhost
IP.1 = 127.0.0.1
IP.2 = ::1
